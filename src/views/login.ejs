<%- include('includes/head') %>
  <%- include('includes/nav') %>

    <div class="container">
      <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
          <h1 class="text-center">Autenticação do Sistema</h1>
          <p class="text-center lead">Faça seu login ou crie sua conta abaixo</p>
          <div class="row">

            <%- include('includes/messages'); %>

            <div class="col-lg" my-5>
                <h4>Faça seu cadastro</h4>
                <p>Crie sua conta para acessar nosso sistema</p>

                <form action="/login/register" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" class="form-control" name="email">
                  </div>
                  <div class="form-group">
                    <label>Senha</label>
                    <input type="password" class="form-control" name="password">
                  </div>

                  <button type="submit" class="btn btn-primary my-4">Criar minha Conta</button>
                </form>

              </div>

              <div class="col-lg" my-5>
                <h4>Faça seu login</h4>
                <p>Se você já tem uma conta, faça seu login abaixo</p>

                <form action="/login/login" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" class="form-control" name="email">
                  </div>
                  <div class="form-group">
                    <label>Senha</label>
                    <input type="password" class="form-control" name="password">
                  </div>

                  <button type="submit" class="btn btn-primary my-4">Entrar no sistema</button>
                </form>


              </div>


          </div>
        </div>

        <div class="col-lg-2"></div>
      </div>
    </div>
    <%- include('includes/footer') %>